generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MediaType {
  movie
  tv
}

enum ReactionTargetType {
  discussion
  review
  comment
  discussion_reply
  review_reply
}

enum ReactionType {
  like
  dislike
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  username     String   @unique
  fullName     String?
  avatarUrl    String?
  bio          String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  favorites         Favorite[]
  watchList         WatchListItem[]
  watchHistory      WatchHistoryItem[]
  discussions       Discussion[]
  discussionReplies DiscussionReply[]
  reviews           Review[]
  reviewReplies     ReviewReply[]
  reactions         Reaction[]

  @@map("users")
}

model Favorite {
  id          String    @id @default(cuid())
  userId      String
  mediaId     String
  mediaType   MediaType
  title       String?
  posterPath  String?
  voteAverage Float?
  overview    String?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, mediaId, mediaType])
  @@map("favorites")
}

model WatchListItem {
  id          String    @id @default(cuid())
  userId      String
  mediaId     String
  mediaType   MediaType
  title       String?
  posterPath  String?
  voteAverage Float?
  overview    String?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, mediaId, mediaType])
  @@map("watch_list")
}

model WatchHistoryItem {
  id            String    @id @default(cuid())
  userId        String
  mediaId       String
  mediaType     MediaType
  title         String?
  posterPath    String?
  seasonNumber  Int?
  episodeNumber Int?
  progress      Int       @default(0)
  duration      Int       @default(0)
  lastWatchedAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, mediaId, mediaType])
  @@map("watch_history")
}

model Discussion {
  id          String    @id @default(cuid())
  userId      String
  content     String
  mediaId     String?
  mediaType   MediaType?
  mediaTitle  String?
  mediaPoster String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  replies   DiscussionReply[]

  @@index([mediaId, mediaType])
  @@index([createdAt])
  @@map("discussions")
}

model DiscussionReply {
  id           String   @id @default(cuid())
  discussionId String
  userId       String
  content      String
  createdAt    DateTime @default(now())

  discussion Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([discussionId])
  @@map("discussion_replies")
}

model Review {
  id            String    @id @default(cuid())
  userId        String
  mediaId       String
  mediaType     MediaType
  mediaTitle    String?
  mediaPoster   String?
  rating        Int
  content       String
  seasonNumber  Int?
  episodeNumber Int?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  replies   ReviewReply[]

  @@index([mediaId, mediaType])
  @@map("reviews")
}

model ReviewReply {
  id        String   @id @default(cuid())
  reviewId  String
  userId    String
  content   String
  createdAt DateTime @default(now())

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([reviewId])
  @@map("review_replies")
}

model Reaction {
  id         String             @id @default(cuid())
  userId     String
  targetId   String
  targetType ReactionTargetType
  type       ReactionType
  createdAt  DateTime           @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetId, targetType])
  @@index([targetId, targetType])
  @@map("reactions")
}

model AppLog {
  id        String   @id @default(cuid())
  level     String
  message   String
  context   Json?
  createdAt DateTime @default(now())

  @@index([level, createdAt])
  @@map("app_logs")
}
