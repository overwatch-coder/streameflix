# TMDB API Key - Get from https://www.themoviedb.org/settings/api
NEXT_PUBLIC_TMDB_API_KEY=your_tmdb_api_key_here

# RapidAPI Key - Get from https://rapidapi.com/
NEXT_PUBLIC_RAPIDAPI_KEY=your_rapidapi_key_here

# OMDB API Key - Get from http://www.omdbapi.com/apikey.aspx
NEXT_PUBLIC_OMDB_API_KEY=your_omdb_api_key_here

# Next.js Environment
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Local PostgreSQL for development. Use your production PostgreSQL URL in production.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/streameflix?schema=public"

# Auth
AUTH_SECRET="replace-this-with-a-long-random-secret"

# Cloudinary
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"
